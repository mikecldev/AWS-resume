# --- PYTHON (BACKEND) EXCLUSIONS ---
# Compiled Files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
.venv/
venv/
ENV/
env/

# Testing Artifacts
.pytest_cache/
.coverage
htmlcov/
*.cover
.hypothesis/
*.egg-info/ # Common Python packaging artifact

# Distribution / Packaging / Lambda
build/
dist/
*.zip
lambda-package/
package/
.aws-sam/
samconfig.toml

# --- TERRAFORM (IAC) EXCLUSIONS ---
# CRITICAL: State Files and Secrets
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
encryption.json
.terraform.lock.hcl # Include if you want to allow different provider versions locally

# Backups and Import Scripts
backups/
terraform/import-resources.ps1

# --- SECRETS & ENVIRONMENT FILES ---
# Environment Variables & Credentials (CRITICAL)
.env
.env.local
*.pem
*.key
**/credentials
**/secrets.json
aws-credentials.json

# --- IDEs & OS FILES ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- GENERAL EXCLUSIONS ---
*.log
drafts/
md/
